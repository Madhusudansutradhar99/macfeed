{
  "appId": "com.macfeed.macfeed",
  "appName": "MacFeed",
  "webDir": "dist",
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#08182b"
    },
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor": "#08182b",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
